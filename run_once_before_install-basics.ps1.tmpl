{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
# --- Linux specific ---
echo "==> Running Linux/WSL basic tools installation..."

# Install ccache if missing based on package manager
if ! command -v ccache >/dev/null; then
    echo "    Installing ccache..."
    if command -v dnf >/dev/null; then
        sudo dnf install -y ccache
    elif command -v apt-get >/dev/null; then
        sudo apt-get update && sudo apt-get install -y ccache
    fi
fi

# Install command-not-found helper if missing based on package manager
if command -v dnf >/dev/null; then
    if [ ! -x /usr/libexec/pk-command-not-found ]; then
        echo "    Installing PackageKit-command-not-found..."
        sudo dnf install -y PackageKit-command-not-found
    fi
elif command -v apt-get >/dev/null; then
    if [ ! -f /etc/zsh_command_not_found ]; then
        echo "    Installing command-not-found..."
        sudo apt-get update && sudo apt-get install -y command-not-found
    fi
fi

if [ ! -f "$HOME/.vim/autoload/plug.vim" ]; then
    echo "    Installing vim-plug..."
    curl -fLo "$HOME/.vim/autoload/plug.vim" --create-dirs \
        https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
fi

if [ ! -d "$HOME/.fzf" ]; then
    echo "    Installing fzf..."
    git clone --depth 1 https://github.com/junegunn/fzf.git ~/.fzf
    ~/.fzf/install --bin
fi

if ! command -v zoxide >/dev/null; then
    echo "    Installing zoxide..."
    curl -sSfL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | sh
fi

if ! command -v mise >/dev/null; then
    echo "    Installing mise..."
    curl https://mise.run | sh
fi

if ! command -v fnm >/dev/null; then
    echo "    Installing fnm..."
    curl -fsSL https://fnm.vercel.app/install | bash
fi

echo "==> Linux initialization complete."

{{ else if eq .chezmoi.os "windows" -}}
# --- Windows Specific ---
Write-Host "==> Verifying Windows infrastructure applications via scoop..." -ForegroundColor Cyan

$requiredApps = @("zoxide", "fzf", "fd", "uv", "fnm")
foreach ($app in $requiredApps) {
    if (-not (Get-Command $app -ErrorAction SilentlyContinue)) {
        Write-Host "    [!] Missing $app. Installing via scoop..." -ForegroundColor Yellow
        scoop install $app
    } else {
        Write-Host "    [✓] $app is already installed." -ForegroundColor Green
    }
}

# --- Install vim-plug for Windows ---
$VimPlugPath = "$HOME\vimfiles\autoload\plug.vim"
if (-not (Test-Path $VimPlugPath)) {
    Write-Host "    [!] vim-plug is missing. Installing for Vim..." -ForegroundColor Yellow
    # Ensure the directory exists before downloading
    New-Item -ItemType Directory -Force -Path (Split-Path $VimPlugPath) | Out-Null
    
    # Download vim-plug
    Invoke-WebRequest -UseBasicParsing -Uri "https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim" -OutFile $VimPlugPath
    Write-Host "    [✓] vim-plug successfully installed." -ForegroundColor Green
} else {
    Write-Host "    [✓] vim-plug is already installed." -ForegroundColor Green
}

Write-Host "==> Windows verification complete." -ForegroundColor Cyan
{{ end -}}