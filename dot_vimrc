set shell=zsh

call plug#begin('~/.vim/plugged')

" List plugins here:
Plug 'tpope/vim-commentary'         " Easy commenting (gcc)
Plug 'tpope/vim-surround'           " Change surroundings (quotes, brackets)
" Plug 'junegunn/fzf'                 " fzf plugin
Plug '~/.fzf'
Plug 'junegunn/fzf.vim'             " -- for vim (fzf)

call plug#end()


" --- General Settings ---
set nocompatible            " Disable compatibility with old vi
set number                  " Show line numbers
set relativenumber          " Show relative line numbers for easier jumping
set mouse=a                 " Enable mouse support
set clipboard=unnamedplus   " Use system clipboard
set showmatch               " Highlight matching brackets
set ignorecase              " Ignore case when searching
set smartcase               " Override ignorecase if search contains capitals
set hlsearch                " Highlight all search results
set incsearch               " Incremental search
set cursorline              " Highlight the current line
set termguicolors           " Enable 24-bit RGB colors

" --- Indentation ---
set expandtab               " Convert tabs to spaces
set shiftwidth=4            " Number of spaces for auto-indent
set tabstop=4               " Number of spaces per tab
set smartindent             " Insert indents automatically

" --- Performance & Undo ---
set hidden                  " Hide buffers instead of closing them
set nobackup                " Recommended by many plugins
set nowritebackup
set updatetime=300          " Faster diagnostic messages
set undofile                " Maintain undo history between sessions

" --- Key Mappings ---
let mapleader = " "         " Set spacebar as leader key

" Clear search highlights
nnoremap <leader>h :nohlsearch<CR>

" Faster split navigation
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" --- FZF Configuration ---
" Bind Ctrl+P to open the file finder with a right-side preview layout
nnoremap <C-p> :Files<CR>

" Configure fzf preview options (Uses default layout if popups aren't supported)
let g:fzf_layout = { 'window': { 'width': 0.95, 'height': 0.95 } }
let g:fzf_vim = {}
let g:fzf_vim.preview_window = ['right,50%', 'ctrl-/']

" --- File Type Specifics ---
filetype plugin indent on   " Enable filetype detection
syntax on                   " Enable syntax highlighting

" --- VS Code-like Shortcuts for Vim ---

" Save File (Ctrl + S)
nnoremap <C-s> :w<CR>
inoremap <C-s> <Esc>:w<CR>a

" Quit Vim (Ctrl + Q)
nnoremap <C-q> :q<CR>

" Undo (Ctrl + Z)
nnoremap <C-z> u
inoremap <C-z> <Esc>ua

" Redo (Ctrl + Y)
nnoremap <C-y> <C-r>
inoremap <C-y> <Esc><C-r>a

" Find Text (Ctrl + F)
nnoremap <C-f> /

" Select All (Ctrl + A)
nnoremap <C-a> ggVG

" Copy / Clipboard Integration (Ctrl + C in Visual Mode)
" Requires Vim compiled with +clipboard
vnoremap <C-c> "+y

" Paste from Clipboard (Ctrl + V in Normal/Insert Mode)
nnoremap <C-v> "+p
inoremap <C-v> <C-r>+

" Cut Text (Ctrl + X in Visual Mode)
vnoremap <C-x> "+x

" Toggle Line Comment (Ctrl + /)
" Note: Terminal Vim often reads Ctrl+/ as Ctrl+_ or Backspace. 
" If Ctrl+/ fails, use Ctrl+_ instead.
nnoremap <C-_> :execute "normal! I// \<Esc>"<CR>
vnoremap <C-_> :s/^/\/\/ /<CR>:noh<CR>

" Move current line down (Alt + Down)
nnoremap <A-Down> :m .+1<CR>==
inoremap <A-Down> <Esc>:m .+1<CR>==gi

" Move current line up (Alt + Up)
nnoremap <A-Up> :m .-2<CR>==
inoremap <A-Up> <Esc>:m .-2<CR>==gi

" Move selected block down in Visual mode (Alt + Down)
vnoremap <A-Down> :m '>+1<CR>gv=gv

" Move selected block up in Visual mode (Alt + Up)
vnoremap <A-Up> :m '<-2<CR>gv=gv

" Duplicate line down (Shift + Alt + Down)
nnoremap <S-A-Down> :t .<CR>
inoremap <S-A-Down> <Esc>:t .<CR>gi

" Duplicate line up (Shift + Alt + Up)
nnoremap <S-A-Up> :t .-1<CR>
inoremap <S-A-Up> <Esc>:t .-1<CR>gi

" Duplicate selected block down in Visual mode (Shift + Alt + Down)
vnoremap <S-A-Down> :t '><CR>gv

" Duplicate selected block up in Visual mode (Shift + Alt + Up)
vnoremap <S-A-Up> :t '<-1<CR>gv


